/* The graphical client's screens (docs/client.md): a panel against the frame's left edge, and the
   flight panel against its right while a journey is under way. Over the engine's ui/base.rcss, whose
   palette (the dev tools', Mocha) gives the panels, the text roles and the buttons their colours: this
   file gives the metrics, and the colours of the inputs the base has no rule for, by the same roles. */

#window {
	position: absolute;
	left: 20dp;
	top: 20dp;
	width: 780dp;
	padding: 12dp 16dp;
	border-width: 1dp;
	border-radius: 4dp;
}

#flight {
	position: absolute;
	right: 20dp;
	top: 20dp;
	width: 320dp;
	padding: 12dp 16dp;
	border-width: 1dp;
	border-radius: 4dp;
}

#nav {
	margin-bottom: 8dp;
}

h2 {
	font-size: 18dp;
	margin-top: 10dp;
	margin-bottom: 4dp;
}

p {
	margin-bottom: 4dp;
}

table {
	width: 100%;
}

td {
	padding: 2dp 4dp;
}

.number {
	text-align: right;
}

#status {
	margin-top: 8dp;
}

input.text {
	width: 220dp;
	padding: 2dp 4dp;
	border: 1dp #313244;       /* Border */
	background-color: #181825; /* Surface, mantle */
}

input.range {
	width: 240dp;
	height: 16dp;
}

input.range slidertrack {
	height: 4dp;
	margin-top: 6dp;
	background-color: #45475a; /* Subtle, surface1 */
}

input.range sliderbar {
	width: 12dp;
	height: 16dp;
	background-color: #89b4fa; /* Primary, blue */
}

input.range sliderarrowdec, input.range sliderarrowinc {
	width: 0dp;
	height: 0dp;
}
