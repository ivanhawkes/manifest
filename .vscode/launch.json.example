{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Simulation unit tests",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/clang-debug/source/game/sim/manifest_sim_tests",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "CMake: build"
        },
        {
            "name": "Development TUI",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/build/clang-debug/source/tools/tui/manifest_tui",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "CMake: build"
        }
    ]
}
