{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: configure",
            "type": "shell",
            "command": "cmake",
            "args": ["--preset", "clang-debug"],
            "problemMatcher": []
        },
        {
            "label": "CMake: build",
            "type": "shell",
            "command": "cmake",
            "args": ["--build", "--preset", "clang-debug"],
            "dependsOn": ["CMake: configure"],
            "group": {"kind": "build", "isDefault": true},
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "CTest: test",
            "type": "shell",
            "command": "ctest",
            "args": ["--preset", "clang-debug"],
            "dependsOn": ["CMake: build"],
            "group": {"kind": "test", "isDefault": true},
            "problemMatcher": []
        }
    ]
}
